@echo off
chcp 65001 >nul
setlocal
set "DIR=%USERPROFILE%\MultiMarket"
if not exist "%DIR%" mkdir "%DIR%"
echo 시중 최저가 자동 조회를 설치합니다 (PC가 켜져 있는 동안 1분마다 확인, 지금 찾기 직후 바로 조회)
where python >nul 2>nul
if errorlevel 1 goto nopy
for /f "delims=" %%P in ('where python') do (
  set "PY=%%P"
  goto :got
)
:got
powershell -NoProfile -Command "$t=[IO.File]::ReadAllText('%~f0'); $b=(($t -split '::PYB64::')[-1] -split [char]10 | ForEach-Object { $_.Trim() -replace '^::','' }) -join ''; [IO.File]::WriteAllBytes('%DIR%\naver_lowest.py',[Convert]::FromBase64String($b))"
if not exist "%DIR%\naver_lowest.py" goto fail
if exist "%DIR%\pc_token.txt" goto havetok
echo.
echo 처음 한 번만: 채팅으로 받은 PC 토큰을 붙여넣고 엔터를 누르세요.
set /p TOK=토큰: 
>"%DIR%\pc_token.txt" echo %TOK%
:havetok
set "PYW=%PY:python.exe=pythonw.exe%"
if not exist "%PYW%" set "PYW=%PY%"
schtasks /end /tn "MultiMarket NaverLowest" >nul 2>nul
schtasks /create /tn "MultiMarket NaverLowest" /tr "\"%PYW%\" -I \"%DIR%\naver_lowest.py\"" /sc minute /mo 1 /f
schtasks /run /tn "MultiMarket NaverLowest"
echo.
echo 설치 끝. 지금부터 PC가 켜져 있는 동안 1분마다 서버를 확인해서, 지금 찾기 직후 바로 최저가를 조회합니다 (창은 안 뜹니다).
echo 결과 기록: %DIR%\naver_lowest.log
pause
exit /b 0
:nopy
echo python 을 찾을 수 없습니다. 이 창을 캡처해서 알려 주세요.
pause
exit /b 1
:fail
echo 설치 파일을 만들지 못했습니다. 이 창을 캡처해서 알려 주세요.
pause
exit /b 1
